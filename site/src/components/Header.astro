---
import Search from "virtual:starlight/components/Search"
import ThemeSelect from "virtual:starlight/components/ThemeSelect"
import BrandMark from "./BrandMark.astro"

const pathname = Astro.url.pathname
const { hasSidebar } = Astro.locals.starlightRoute
// GitHub belongs in this list rather than beside the header controls. It is a
// destination like the other four, and as a lone anchor between the search
// field and the theme control it read as a control that does nothing.
const links = [
  { label: "Skills", href: "/skills/" },
  { label: "Standard", href: "/standard/" },
  { label: "Start here", href: "/guides/getting-started/" },
  { label: "Changelog", href: "/changelog/" },
  { label: "GitHub", href: "https://github.com/svyatov/oss-kit", external: true },
]
---

<div class="kit-header">
  <a class="kit-header__brand" href="/" aria-label="oss-kit home">
    <BrandMark />
    <span>oss-kit</span>
  </a>

  <nav class="kit-header__nav" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={!link.external && pathname.startsWith(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="kit-header__tools">
    <Search />
    <ThemeSelect />
    <a class="kit-header__install" href="/guides/install/">Install</a>
    {
      // Any page without a sidebar needs this drawer, not the home page alone:
      // the 404 is a splash template too, and gating on the path left it with no
      // navigation at all under 1024px, which is the width a lost reader most
      // needs a way out. On a page that has a sidebar, Starlight's own menu
      // button already owns the job, and a second drawer beside it would offer
      // the reader two different "Menu"s.
      !hasSidebar && (
        <details class="kit-mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile primary">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </details>
      )
    }
  </div>
</div>

<script>
  // The sidebar runs longer than the viewport, so the current page can be
  // marked correctly and still sit hundreds of pixels below the fold. Arriving
  // on a rule page from search is the common case, and that is exactly when a
  // reader needs to see where they landed.
  const current = document.querySelector('#starlight__sidebar [aria-current="page"]')
  current?.scrollIntoView({ block: "center" })
</script>
