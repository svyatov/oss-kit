---
import Search from "virtual:starlight/components/Search"
import ThemeSelect from "virtual:starlight/components/ThemeSelect"
import BrandMark from "./BrandMark.astro"

const pathname = Astro.url.pathname
const links = [
  { label: "Skills", href: "/skills/" },
  { label: "Standard", href: "/standard/" },
  { label: "Guides", href: "/guides/getting-started/" },
  { label: "Changelog", href: "/changelog/" },
]
---

<div class="kit-header">
  <a class="kit-header__brand" href="/" aria-label="oss-kit home">
    <BrandMark />
    <span>oss-kit</span>
  </a>

  <nav class="kit-header__nav" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={pathname.startsWith(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="kit-header__tools">
    <Search />
    <a class="kit-header__github" href="https://github.com/svyatov/oss-kit">GitHub</a>
    <ThemeSelect />
    <a class="kit-header__install" href="/guides/install/">Install</a>
    {
      // Only the splash page lacks a sidebar, so only it needs a nav drawer.
      // On a docs page Starlight's own menu button already owns that job, and a
      // second drawer beside it would offer the reader two different "Menu"s.
      pathname === "/" && (
        <details class="kit-mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile primary">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
            <a href="https://github.com/svyatov/oss-kit">GitHub</a>
          </nav>
        </details>
      )
    }
  </div>
</div>

<script>
  // The sidebar runs longer than the viewport, so the current page can be
  // marked correctly and still sit hundreds of pixels below the fold. Arriving
  // on a rule page from search is the common case, and that is exactly when a
  // reader needs to see where they landed.
  const current = document.querySelector('#starlight__sidebar [aria-current="page"]')
  current?.scrollIntoView({ block: "center" })
</script>
